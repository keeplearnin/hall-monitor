# Changes to an agent's hall pass, its prompt or its approval need the owner's review, and so
# do the eval gate, the published results it trusts (each records its own agent digests) and the
# answer keys behind them. CODEOWNERS takes effect only with branch protection that requires
# code-owner review.
/registry/                @keeplearnin
/hall_monitor/            @keeplearnin
/.github/                 @keeplearnin
/controls/                @keeplearnin
/evals/                   @keeplearnin
/data/synthetic/          @keeplearnin
/data/cfpb/               @keeplearnin
# Stopping an agent needs no review: no code owner for the stop list. Restarting one is a change
# to approvals.yaml, which the /registry/ rule above covers.
/registry/stops.yaml
